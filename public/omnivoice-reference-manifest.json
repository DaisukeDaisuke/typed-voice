      "provider": "huggingface",
      "repo": "onnx-community/OmniVoice-Onnx",
      "revision": "a7be7c65cc118137683f49eff0f80fdf9d5b5dbf"
    }
  },
  "runtime": {
    "preferWebGpu": true,
    "tokenizerDirectory": "tokenizer",
    "hiddenSize": 1024,
    "numKvHeads": 8,
    "headDim": 128,
    "sampleRate": 24000,
    "decoderInputName": "codes",
