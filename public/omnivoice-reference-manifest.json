      "audio_mask_id": 1024,
      "audio_vocab_size": 1025,
      "numStep": 16,
      "guidanceScale": 4,
      "tShift": 0.05
    },
    "sessions": {
      "audioEmbeddings": {
        "model": "models/audio_embeddings_encoder.onnx",
        "externalData": [
          {
            "path": "audio_embeddings_encoder.onnx.data",
            "localPath": "models/audio_embeddings_encoder.onnx.data"
          }
        ]
      },
      "llm": {
        "model": "models/llm_decoder.onnx",
        "externalData": [
          {
            "path": "llm_decoder.onnx.data",
            "localPath": "models/llm_decoder.onnx.data"
          }
        ]
      },
      "audioHeads": {
        "model": "models/audio_heads_decoder.onnx"
      },
      "higgsDecoder": {
        "model": "models/higgs_decoder.onnx",
        "externalData": [
          {
            "path": "higgs_decoder.onnx.data",
            "localPath": "models/higgs_decoder.onnx.data"
          }
        ]
      }
    }
  },
  "licenses": {
